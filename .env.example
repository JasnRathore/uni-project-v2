# Database target: local SQLite file or remote Turso database.
DATABASE_TARGET=local

# Used when DATABASE_TARGET=local.
LOCAL_DATABASE_URL=file:local.db

# Required when DATABASE_TARGET=turso.
# Use the libSQL URL from the Turso database details page.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Optional local API server port.
PORT=3001

# Required for signing and verifying local API login tokens.
# Generate a random value for each environment; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

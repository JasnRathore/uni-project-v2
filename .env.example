# Database target: local SQLite file or remote Turso database.
DATABASE_TARGET=local

# Used when DATABASE_TARGET=local.
LOCAL_DATABASE_URL=file:local.db

# Required when DATABASE_TARGET=turso.
# Use the libSQL URL from the Turso database details page.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Optional local API server port.
PORT=3001

# Required for signing and verifying local API login tokens.
# Generate a random value for each environment; never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Transactional email is sent through Gmail SMTP using an app password.
# MAIL is the full Gmail address that sends the email.
# MAIL_PASSWORD must be a Google "app password" (not the account password).
# When either value is missing the app still starts and authenticates; email sends
# are skipped and logged instead of failing the request.
MAIL=
MAIL_PASSWORD=

# Optional override for the From header, e.g. "Dental College Portal <no-reply@example.edu>".
# Defaults to the MAIL address when unset.
MAIL_FROM=

# Public base URL used to build links in emails (password reset links).
# Falls back to NEXT_PUBLIC_APP_URL, then http://localhost:3000.
APP_URL=http://localhost:3000
